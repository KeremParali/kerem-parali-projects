-- çalışan raporu için sanal tablo (geçici)

CREATE VIEW vw_CaisanRaporu AS 
SELECT 
p.Firstname,
p.Lastname,
e.JobTitle

FROM Person.Person p
JOIN HumanResources.Employee e 
ON p.BuisnessEntityID = e.BuisnessEntityID;
GO


use AdvantureWorks2022;

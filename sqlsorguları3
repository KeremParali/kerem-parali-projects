-- Bir çalışanın izin saatini 5 saat arttırma
UPDATE HumanResources.Employee 
SET VacaitonHours = VacaitonHours + 5
WHERE BuisnessEntityID = 1;
GO

-- Kontrol etme

SELECT 
BuisnessEntityID,
VacaitonHours
FROM HumanResources.Employee
WHERE BuisnessEntityID = 1;
GO

--Çalışanların işe giriş tarihine 100 gün ekleme

SELECT 
HireDate,
DATEADD(DAY,100,HireDate) AS YeniTarih
FROM HumanResources.Employee
GO

-- Bugünün tarihini bul

SELECT GETDATE() AS BugününTarihi;
GO

-- Her çalışanın maaş sıralamasını bul

SELECT 
BuisnessEntityID,
Rate,
RANK() OVER(ORDER BY Rate ASC) AS MaasSirasi
FROM HumanResources.EmployeePayHistory;
GO

-- Her ürün rengindeki en pahalı ürün

SELECT
Color,
MAX(ListPrice) AS YüksekFiyat
FROM Production.Product 
GROUP BY Color;
GO

-- Ürün fiyat bilgilerini bir arada gösterme

SELECT 
AVG(ListPrice) AS Ortalama,
MIN(ListPrice) AS EnDüsükFiyat,
MAX(ListPrice) AS EnYüksekFiyat
FROM Production Product;
GO

-- Ürünleri fiyat farkına göre hesapla 

SELECT
Name,
ListPrice,
ListPrice - 
(
SELECT AVG(ListPrice)
FROM Production.Product 
) AS OrtalamaFarki

FROM Production.Product;
GO

-- Çalışan bilgilerinin yanında ortalama maaşları gösterme 

SELECT 
BuisnessEntityID,
Rate,
AVG(Rate) OVER() AS OrtalamaMaas 
FROM HumanResources.EmployeePayHistory;
GO

-- Ürünün Adının ilk harfi
-- ilk harf dediğimiz için 1 dedik

SELECT 
Nmae,
LEFT(Name, 1) AS İlkHarf 
FROM Production.Product;
GO 

-- Çalışanların işe giriş ayları

SELECT 
BuisnessEntityID,
HireDate,
MONTH(HireDate) AS GirisAyi
FROM HumanResources.Employee;
GO

SELECT 
NAME,
ListPrice
FROM Production.Product
ORDER BY NAME DESC;
GO


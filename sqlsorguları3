/* Adsoyad bilgisiyle iş ünvanlarını birleştir */

SELECT 
CONCAT(p.FirstName, p.LastName) AS 'CalisanAdi',
e.JobATitle 
FROM Person.Person p
JOIN HumanResources.Employee e
ON p.BuisnessEntityID = e.BuisnessEntityID;

/* işe giriş yılı 2010 dan sonra olan çalışanları listeleyiniz. */
/* Sorgu ne yapıyor soruları gelebilir */

SELECT 
BuisnessEntityID,
JobATitle,
HireDate
FROM HumanResources.Employee
WHERE HireDate > '2010-10-20'
GO

/* her yıl kaç çalışan işe alınmış bulun */ 

SELECT 
YEAR(HireDate) AS İseGirisYili,
COUNT(*) AS CalisanSayisi
FROM HumanResources.Employee
GROUP BY YEAR(HireDate)
ORDER BY İseGirisYili;

/* Her çalışanın kaç yıl çalıştığını bulun */

SELECT 
BuisnessEntityID,
JobATitle,
HireDate
DATEDIFF(YEAR, HireDate,GETDATE()) AS CalismaYili
FROM HumanResources.Employee;

/* Departman geçmişinde kaydı hala devam eden kayıtları bul */

SELECT * 
FROM HumanResources.EmployeeDepartmanHistory
WHERE EndDate IS NULL;

/* Departman geçmişinde EndDate boşsa "Aktif Görev yazdır */

SELECT 
BuisnessEntityID,
StartDate,
ISNULL(CAST(EndDate AS VARCHAR), 'Aktif Görev') AS GorevDurumu

/* Ortalama saatlik ücretin üzerinde ücret alan kayıtları bulunuz. */

BuisnessEntityID,
Rate
FROM HumanResources.EmployeePayHistory
WHERE Rate > (
SELECT AVG (Rate)
FROM HumanResources.EmployeePayHistory
);

/* En yüksek saatlik ücreti bulunuz */

SELECT
BuisnessEntityID,
Rate
FROM HumanResources.EmployeePayHistory
WHERE Rate = (
SELECT MAX (Rate)
FROM HumanResources.EmployeePayHistory
);

/* Her müşteri için kaç siparişi olduğunu bulunuz. */

SELECT CustomerID,
COUNT(*) AS SiparisSayisi 
FROM Sales.SalesOrderHeader,
GROUP BY CustomerID
ORDER BY SiparisSayisi DESC;

/* Her müşteri için toplam harcama ve ortalama sipariş tutarını bulunuz. */

SELECT CustomerID,
COUNT(*) AS SiparisSayisi,
sum(TotalDue) as toplam_harcama,
avg(TotalDue) as ortalama_siparis
FROM Sales.SalesOrderHeader
GROUP BY CustomerID
ORDER BY ToplamHarcama DESC;
GO


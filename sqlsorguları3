/* isim ve soyisim birleştirme */
SELECT FirstName, LastName
CONCAT as (FirstName, ' ', LastName) AS 'TamAd'
from Person.Person 

/* fiyatı 1000 den büyük olan ürünler */

SELECT 
ProductID, Name, ListPrice
FROM Production.Product 
WHERE ListPrice > 1000;

/* en pahalı 10 ürün listele büyükten küçüğe(desc) */

SELECT TOP 10 
ProductID, Name, ListPrice 
from Production Product;
ORDER BY ListPrice DESC;

/* ürünleri fiyatlarına göre sınıflandır 500 den küçükse 'Düşük' 500-1500 arası 'Orta', büyükse 'Yüksek' */

SELECT 
ProductID, Name, Listprice
CASE 
WHEN ListPrice < 500 THEN 'Düşük'
WHEN ListPrice BETWEEN 500 AND 1500 THEN 'Orta'
ELSE 'Yüksek'
AND AS FiyatAralığı
From Production.Product;
GO

/* her ürün renginden kaç ürün olduğunu bul  */

SELECT color COUNT(*) as UrunSayisi
FROM Production.Product 
From Production.P
GROUP BY UrunSayisi DESC;

/* 10 dan fazla ürüne sahip renkleri listeleyiniz */

SELECT color COUNT(*) as UrunSayisi
FROM Production.Product 
GROUP BY Color
HAVING COUNT(*) > 10
ORDER BY UrunSayisi DESC;
GO 

